{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneX Desktop",
  "version": "0.1.0",
  "identifier": "com.onex.desktop",
  "build": {
    "frontendDist": [
      "../../desktop-ui/index.html",
      "../../desktop-ui/app.css",
      "../../desktop-ui/app.js"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OneX Desktop",
        "url": "index.html",
        "width": 420,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "capabilities": ["desktop-main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "../../deploy/windows/installer-hooks.nsh"
      }
    },
    "externalBin": ["binaries/onex", "binaries/onexd"],
    "resources": {
      "../../deploy/windows/onex-run-claude.cmd": "onex-run-claude.cmd"
    }
  }
}
