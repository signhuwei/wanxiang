{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneX Desktop",
  "version": "0.1.0",
  "identifier": "com.onex.desktop",
  "build": {
    "frontendDist": [
      "../../desktop-ui/index.html",
      "../../desktop-ui/app.css",
      "../../desktop-ui/app.js",
      "../../server/web/theme.css",
      "../../server/web/logo.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OneX Desktop",
        "url": "index.html",
        "width": 420,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "capabilities": ["desktop-main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
