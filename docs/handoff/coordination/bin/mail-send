#!/bin/bash
# 用法：mail-send <收件人> <发件人> [正文]；不给正文时从标准输入读。
# 收件人：governor edge server web magpie sima
set -euo pipefail
M=/Users/HHH/Code/OneX/coord/mail
to=$1 from=$2; shift 2
[ -d "$M/$to" ] || { echo "unknown recipient: $to" >&2; exit 2; }
body=${1:-$(cat)}
ts=$(date +%Y%m%dT%H%M%S)-$$-$RANDOM
tmp="$M/$to/.tmp-$ts"
{ echo "from: $from"; echo "at: $(date '+%Y-%m-%d %H:%M:%S')"; echo; echo "$body"; } > "$tmp"
mv "$tmp" "$M/$to/$ts-$from.md"
echo "sent to $to: $ts-$from.md"
